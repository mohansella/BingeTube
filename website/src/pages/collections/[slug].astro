---
import Layout from "../../layout/layout.astro";
import {
  getAppSeriesUrl,
  getCollections,
  type CollectionViewModel,
} from "../../lib/discover";

export function getStaticPaths() {
  return getCollections().map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}

interface Props {
  collection: CollectionViewModel;
}

const { collection } = Astro.props;
const title = collection.seoTitle;
const description = collection.seoDescription;
const hero = collection.series[0];
const collectionUrl = new URL(`/collections/${collection.slug}/`, Astro.site ?? Astro.url);
const schemaJson = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: collection.name,
  description,
  url: collectionUrl.href,
  mainEntity: {
    "@type": "ItemList",
    name: `${collection.name} series`,
    numberOfItems: collection.series.length,
    itemListElement: collection.series.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.title,
      url: new URL(getAppSeriesUrl(item.id), Astro.site ?? Astro.url).href,
    })),
  },
};
---

<Layout
  title={title}
  description={description}
  canonicalURL={collectionUrl.href}
  image={hero.coverUrl}
  schemaJson={schemaJson}
>
  <section class="relative overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0">
      <img src={hero.coverUrl} alt="" class="h-full w-full object-cover opacity-25" />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/80 to-black/70"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 py-14 sm:py-20">
      <a href="/collections/" class="text-sm font-medium text-[#FF6666] hover:text-[#FF9999]">
        Collections
      </a>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold tracking-tight sm:text-6xl">
        {collection.name}
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-300">
        {collection.description}
      </p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm text-slate-300">
        <span class="rounded-full border border-slate-700 bg-black/40 px-4 py-2">
          {collection.series.length} series
        </span>
        <span class="rounded-full border border-slate-700 bg-black/40 px-4 py-2">
          {collection.totalVideos.toLocaleString()} videos
        </span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-12 sm:py-16">
    <div class="mb-10 grid gap-6 border-b border-slate-800 pb-10 lg:grid-cols-[1fr_320px]">
      <div>
        <h2 class="text-2xl font-semibold text-white">What this collection covers</h2>
        <p class="mt-4 max-w-3xl leading-7 text-slate-300">
          {collection.editorialNote}
        </p>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-950 p-5">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#FF6666]">
          Includes
        </p>
        <ul class="mt-4 space-y-2 text-sm text-slate-300">
          {collection.series.slice(0, 4).map((item) => (
            <li>{item.title}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      {collection.series.map((item, index) => (
        <article class="overflow-hidden rounded-xl border border-slate-800 bg-slate-950">
          <div class="grid gap-0 sm:grid-cols-[220px_1fr]">
            <div class="relative aspect-video bg-slate-900 sm:aspect-auto">
              <img src={item.coverUrl} alt="" class="h-full w-full object-cover" />
              <span class="absolute left-3 top-3 rounded-md bg-black/75 px-2 py-1 text-xs font-semibold text-white">
                {index + 1}
              </span>
            </div>
            <div class="p-5">
              <div class="flex items-start gap-3">
                <img
                  src={item.iconUrl}
                  alt=""
                  class="mt-1 h-9 w-9 shrink-0 rounded-full border border-slate-700 object-cover"
                />
                <div class="min-w-0">
                  <h2 class="text-xl font-semibold text-white">{item.title}</h2>
                  <p class="mt-1 text-sm text-slate-400">{item.totalVideos.toLocaleString()} videos</p>
                </div>
              </div>
              <p class="mt-4 line-clamp-3 text-sm leading-6 text-slate-400">
                {item.description || "A curated BingeTube series organized for sequential, repeat-free watching."}
              </p>
              <a
                href={getAppSeriesUrl(item.id)}
                class="mt-5 inline-flex rounded-lg bg-[#E61819] px-4 py-2 text-sm font-medium text-white transition hover:bg-[#FF4444]"
              >
                Open in app
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-slate-800 bg-slate-950/60">
    <div class="mx-auto max-w-7xl px-6 py-10">
      <a href="/collections/" class="text-[#FF6666] hover:text-[#FF9999]">
        Browse all collections
      </a>
    </div>
  </section>
</Layout>
